{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "type": "command",
        "bash": "python3 \"$PLUGIN_ROOT/scripts/telemetry.py\" hook copilot",
        "timeoutSec": 5
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "[ \"${DAILY_WORK_CONTENT:-}\" = 0 ] || python3 \"$PLUGIN_ROOT/scripts/content.py\" hook copilot-prompt; true",
        "timeoutSec": 5
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "[ \"${DAILY_WORK_CONTENT:-}\" = 0 ] || python3 \"$PLUGIN_ROOT/scripts/content.py\" hook copilot-stop; true",
        "timeoutSec": 5
      }
    ]
  }
}
